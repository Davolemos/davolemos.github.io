{
  "manifest_version": 3,
  "name": "Domestika Notes",
  "version": "1.2.0",
  "description": "Recoge subtítulos y capturas de las escenas clave de las lecciones que ves, y los exporta en Markdown para estudiar y destilar en skills.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.domestika.org/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.domestika.org/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Domestika Notes",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "capture-now": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Capturar la escena actual del video"
    }
  }
}
